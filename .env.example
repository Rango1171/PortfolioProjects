# =============================================================================
# LLM Provider API Keys
# At least one is required. Add more for automatic fallback when a quota is hit.
# Priority order: Gemini → Groq → Mistral
# =============================================================================

# Google Gemini  (free tier: 15 RPM, 1 500 req/day for Flash, 500/day for Flash-Lite)
# Get free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy...

# Groq  (free tier: 30 RPM, generous daily limits — Llama 3.1/3.3, Gemma 2)
# Get free key at: https://console.groq.com
GROQ_API_KEY=

# Mistral  (free tier: 1 RPM — slower fallback, but useful when others are exhausted)
# Get free key at: https://console.mistral.ai
MISTRAL_API_KEY=

# =============================================================================
# Google Drive
# =============================================================================

# Google Drive folder ID — get from the folder URL in Google Drive
# Example: https://drive.google.com/drive/folders/1ABC123XYZ  →  folder ID is "1ABC123XYZ"
GOOGLE_DRIVE_FOLDER_ID=

# =============================================================================
# Optional: override default models
# =============================================================================

# Gemini models (defaults shown)
# GEMINI_SCORER_MODEL=gemini-2.0-flash
# GEMINI_CUSTOMIZER_MODEL=gemini-2.5-flash-lite

# Groq models (defaults shown)
# GROQ_SCORER_MODEL=llama-3.1-8b-instant
# GROQ_CUSTOMIZER_MODEL=llama-3.3-70b-versatile

# Mistral models (defaults shown)
# MISTRAL_SCORER_MODEL=mistral-small-latest
# MISTRAL_CUSTOMIZER_MODEL=mistral-small-latest
